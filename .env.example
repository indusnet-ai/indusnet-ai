# PostgreSQL Database Connection (Server-only Neon / Postgres Pooled URL)
DATABASE_URL=postgresql://user:password@ep-sample-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Backend Internal URL (Next.js server-side API Gateway target)
BACKEND_INTERNAL_URL=http://127.0.0.1:8001

# Resend API Key for Email Scoping Reports and Form Notifications
RESEND_API_KEY=your-resend-api-key-here

# Google Analytics 4 Measurement ID (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Careers Mode (static or live)
NEXT_PUBLIC_CAREERS_MODE=static

# Testimonials Feature Flag (false by default until permissioned client quotes are provided)
NEXT_PUBLIC_SHOW_TESTIMONIALS=false

# AI Concierge Server-Side LLM Configuration (Optional - falls back cleanly to deterministic domain engine if omitted)
# Supports OpenAI, Azure OpenAI, Groq, Ollama, vLLM, DeepSeek, or any OpenAI-compatible provider
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=your-api-key-here
AI_BASE_URL=https://api.openai.com/v1
